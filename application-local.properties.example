# Machine-local overrides — copy to `application-local.properties` (gitignored) to activate.
#
# Activated by `spring.profiles.include=local` set in application.properties (dev)
# and application-ai-it.properties (AIIT). Spring Boot then auto-loads this file
# from the default `file:./` config location whenever the `local` profile is
# active. Anything set here wins over the committed defaults.

# --- LLM endpoint (OpenAI-compatible) ---
# NOTE: include the /v1 path — Spring AI's OpenAI client (official OpenAI SDK) appends
# /chat/completions directly to this URL.
spring.ai.openai.base-url=http://your-llm-host:8080/v1
spring.ai.openai.api-key=not-needed
spring.ai.openai.chat.options.model=Qwen3.6-35B-A3B-UD-Q4_K_XL-128k-coding-paralel-2
# spring.ai.openai.chat.options.max-tokens=16384
# Per-call timeout (read + overall). Default 180s; raise for slow CPU-only hosts whose big
# Reports reshapes would otherwise abort mid-stream at the old 60s default (issue #90).
# spring.ai.openai.timeout=180s
