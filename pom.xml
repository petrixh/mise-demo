<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- Project from https://start.vaadin.com/04a0b8f1-ebe9-47b7-bf89-c19e0e5927aa -->
    <groupId>com.example.specdriven</groupId>
    <artifactId>app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    
    <properties>
        <java.version>21</java.version>
        <vaadin.version>25.2.6</vaadin.version>
        <!-- Vaadin AI components are built against a specific Spring AI milestone
             (alpha5 -> M4, beta1 -> M5, rc1/25.2.0 GA -> 2.0.0 GA). Keep this
             aligned with what the vaadin-ai-components-flow POM for
             ${vaadin.version} declares; a mismatched milestone can break
             SpringAILLMProvider at runtime (advisor builder APIs were renamed
             between milestones).
             Vaadin 25.2.0 (stable) declares Spring AI 2.0.0 GA, so we track GA here —
             verified across all three test layers (unit/browserless, Playwright
             IT, and the live-LLM AIIT suite).
             Gotcha: GA adds an <exclusion> for
             tools.jackson.dataformat:jackson-dataformat-yaml on its
             spring-ai-client-chat -> json-schema-validator dependency (M5 left it
             un-excluded, which is how that artifact used to reach our classpath).
             Our YAML seed loaders import it directly, so it is declared as a
             direct dependency below. This is NOT a Jackson 2/3 downgrade — both
             coexist under Spring Boot 4 on every milestone. -->
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>
    
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    
    <dependencies>
        <dependency>
            <groupId>com.vaadin</groupId>
            <!-- Replace artifactId with vaadin-core to use only free components -->
            <artifactId>vaadin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-junit6</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring integration for Browserless: SpringBrowserlessTest, route+bean wiring. -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-spring</artifactId>
            <version>1.1.2</version>
            <scope>test</scope>
        </dependency>
        <!-- DramaFinder: Playwright element wrappers for Vaadin. Activated via -Pit. -->
        <dependency>
            <groupId>org.vaadin.addons</groupId>
            <artifactId>dramafinder</artifactId>
            <version>1.1.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Persistence: Spring Data JPA + H2 (file mode, see application.properties) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- Spring AI: OpenAI-compatible chat model (default: local Qwen) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Jackson 3 YAML dataformat: used directly by StubbedPriceCatalog and
             FilesystemRecipeCatalog (tools.jackson.dataformat.yaml.YAMLMapper) to
             read the demo/data/*.yaml seed files. Must be declared directly under
             Spring AI 2.0.0 GA: GA <exclusion>s this artifact from its
             spring-ai-client-chat -> com.networknt:json-schema-validator dependency
             (Spring AI <= M5 left it un-excluded, which is why it used to arrive
             transitively). Without this direct declaration the code does not compile.
             Version managed by the Spring Boot BOM. -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
    </dependencies>
    
    <build>
        <defaultGoal>spring-boot:run</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    
    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>vaadin-directory</id>
            <url>https://maven.vaadin.com/vaadin-addons</url>
        </repository>
        <repository>
            <id>vaadin-prereleases</id>
            <url>https://maven.vaadin.com/vaadin-prereleases</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>vaadin-prereleases</id>
            <url>https://maven.vaadin.com/vaadin-prereleases</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>

    <profiles>
        <!-- ./mvnw -Pit verify  -> runs *IT.java end-to-end (headless Playwright). -->
        <profile>
            <id>it</id>
            <properties>
                <headless>true</headless>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!--
                                Failsafe's default include is **/*IT.java, which also matches
                                **/*AIIT.java (the suffix `IT.java` is a substring of `AIIT.java`).
                                Exclude AIIT explicitly so -Pit runs Playwright ITs only — AIIT
                                stays gated behind -Pai-it where the live LLM endpoint is wired.
                            -->
                            <excludes>
                                <exclude>**/*AIIT.java</exclude>
                            </excludes>
                            <!-- Manual-example release-gate ITs are opt-in (-Pmanual-verify); never in -Pit. -->
                            <excludedGroups>manual-example</excludedGroups>
                            <systemPropertyVariables>
                                <headless>${headless}</headless>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- ./mvnw -Pit -Pdebug-ui verify  -> opens a visible Chromium window. -->
        <profile>
            <id>debug-ui</id>
            <properties>
                <headless>false</headless>
            </properties>
        </profile>
        <!--
            ./mvnw -Pai-it verify  -> runs *AIIT.java integration tests against the live LLM.
            Spec: AI verification at the tool / orchestrator seam without Playwright or a real
            browser. Each test boots a SpringBootTest(webEnvironment=NONE) and drives the model
            through Spring AI's ChatClient with the same SYSTEM_PROMPT + tool beans as production.
            Two failsafe forks run in parallel to exploit the Qwen-local "parallel-2" slot — each
            fork gets its own in-memory H2 (see application-ai-it.properties), so households /
            plans / MealEdit rows don't collide. ./mvnw -Pai-it verify -Dit.test=PlanToolsAIIT
            scopes to one class.
        -->
        <profile>
            <id>ai-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includes>
                                <include>**/*AIIT.java</include>
                            </includes>
                            <!-- Manual-example release-gate AIITs are opt-in (-Pmanual-verify); never in the regular -Pai-it regression/bake-off run. -->
                            <excludedGroups>manual-example</excludedGroups>
                            <forkCount>2</forkCount>
                            <reuseForks>true</reuseForks>
                            <!-- Coarse backstop: kills a whole fork (the ~4 AIIT classes it runs back-to-back)
                                 if it exceeds 20 min. The real per-test guard is @Timeout(5m) on MiseAIIT; this
                                 only catches a fully-wedged JVM. Sized for the slow 35B's full batch, not per-test. -->
                            <forkedProcessTimeoutInSeconds>1200</forkedProcessTimeoutInSeconds>
                            <systemPropertyVariables>
                                <miseit.forkNumber>${surefire.forkNumber}</miseit.forkNumber>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            ./mvnw -Pmanual-verify verify  -> RELEASE GATE: verify the user-manual "Example queries"
            actually work against the LIVE model. Opt-in, run by intention before a release (wired into
            the /pre-release skill), NOT in regular CI. Runs only @Tag("manual-example") tests, which
            span the headless live-LLM ManualExamplesAIIT (ai-it profile) and the Playwright + live-LLM
            ManualExamplesReportsIT (manual profile — real browser + real model). forkCount=1 keeps the
            browser and a single-slot local endpoint happy. Requires a live endpoint configured in
            application-local.properties (base-url MUST end in /v1). The **/*IT.java include also matches
            **/*AIIT.java (suffix overlap), so the single pattern + the tag filter cover both classes.
        -->
        <profile>
            <id>manual-verify</id>
            <properties>
                <headless>true</headless>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <groups>manual-example</groups>
                            <forkCount>1</forkCount>
                            <reuseForks>true</reuseForks>
                            <systemPropertyVariables>
                                <headless>${headless}</headless>
                                <miseit.forkNumber>${surefire.forkNumber}</miseit.forkNumber>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
